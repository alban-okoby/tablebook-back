            "application/json": {
              "schema": {
                "type": "object",
                "required": ["restaurant", "date", "time", "partySize"],
                "properties": {
                  "restaurant": { "type": "string", "description": "Restaurant ID" },
                  "date": { "type": "string", "format": "date", "example": "2026-08-15" },
                  "time": { "type": "string", "example": "19:30" },
                  "partySize": { "type": "integer", "minimum": 1, "maximum": 50 },
